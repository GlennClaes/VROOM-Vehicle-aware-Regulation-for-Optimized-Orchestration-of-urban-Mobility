# ==============================================================================
# VROOM C++ Controller Edge Cabinet Configuration Template
# Place this file as .env in the cabinet's /app directory
# ==============================================================================

# Unique ID of this intersection cabinet
VROOM_INTERSECTION_ID=hasselt-xl-a

# NATS Broker URL (replace with Cloud NLB / DNS name)
VROOM_NATS_URL=nats://nats.verkeer.hasselt.be:4222

# Security Certificates (mTLS) for Municipal Net Encrypted connection
VROOM_NATS_CA_CERT_PATH=/app/certs/ca.crt
VROOM_NATS_CLIENT_CERT_PATH=/app/certs/client.crt
VROOM_NATS_CLIENT_KEY_PATH=/app/certs/client.key

# Hardware Interface Type: plc (Modbus TCP) | gpio (Linux Sysfs Relays) | mock
VROOM_HARDWARE_ADAPTER=plc

# Modbus PLC endpoint configuration (for hardware_adapter = plc)
VROOM_PLC_ENDPOINT=192.168.1.50:502

# Hardware Watchdog Device node (e.g. /dev/watchdog on physical Raspberry Pi / Linux box)
VROOM_WATCHDOG_PATH=/dev/watchdog

# Security & Safety Timings
VROOM_CONFLICT_MONITOR_ENABLED=true
VROOM_MIN_GREEN_DURATION_MS=6000
VROOM_AMBER_DURATION_MS=3000
VROOM_ALL_RED_DURATION_MS=1500
VROOM_COMMUNICATION_TIMEOUT_MS=1500
VROOM_FIXED_PHASE_DURATION_MS=12000
