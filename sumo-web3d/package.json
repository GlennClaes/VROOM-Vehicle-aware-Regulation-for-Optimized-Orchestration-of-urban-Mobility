{
  "name": "sumoweb3d",
  "version": "1.0.0",
  "description": "3D visualization of SUMO traffic simulations — Vue 3 + Vite + Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "lodash-es": "^4.17.21",
    "proj4": "^2.11.0",
    "stats.js": "^0.17.0",
    "string-hash": "^1.1.3",
    "three": "^0.169.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/dat.gui": "^0.7.9",
    "@types/geojson": "^7946.0.16",
    "@types/lodash-es": "^4.17.12",
    "@types/proj4": "^2.5.5",
    "@types/stats.js": "^0.17.3",
    "@types/string-hash": "^1.1.3",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
